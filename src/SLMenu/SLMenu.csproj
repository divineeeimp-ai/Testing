<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Internal Mono mod DLL for the SCP: Secret Laboratory client.
    It compiles against the DLLs in your own game install (SCPSL_Data\Managed), so a member that
    is missing or non-public in your build fails here with a compiler error instead of at runtime.

    Override the location with:  dotnet build -c Release -p:GameDir="D:\Games\SCP Secret Laboratory"
    or point straight at a Managed folder:  -p:ManagedDir="...\SCPSL_Data\Managed"
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SLMenu</AssemblyName>
    <RootNamespace>SLMenu</RootNamespace>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Unity's modules carry a netstandard 2.x facade reference; the net48 reference pack resolves it. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\SCPSL_Data\Managed</ManagedDir>
  </PropertyGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="Exists('$(GameDir)\GameAssembly.dll')"
           Text="$(GameDir)\GameAssembly.dll exists: this install is IL2CPP. SLMenu is a Mono mod and needs SCPSL_Data\Managed\Assembly-CSharp.dll." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found in '$(ManagedDir)'. Pass -p:GameDir=... (folder that contains SCPSL.exe) or -p:ManagedDir=..." />
    <Error Condition="!Exists('$(ManagedDir)\Mirror.dll') Or !Exists('$(ManagedDir)\Pooling.dll') Or !Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="Mirror.dll, Pooling.dll or UnityEngine.CoreModule.dll is missing from '$(ManagedDir)'." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(ManagedDir)\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pooling"><HintPath>$(ManagedDir)\Pooling.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
